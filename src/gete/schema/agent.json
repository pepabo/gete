{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gete:schema:agent",
  "title": "agent.yaml",
  "description": "One agent: who it is, what it says, what it touches, where it runs, where it is listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "display_name",
    "description",
    "model",
    "instruction"
  ],
  "properties": {
    "name": {
      "description": "RFC 1034 label. Becomes the Terraform module name, the service account name, and the prefix of authorization ids.",
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "description": "Path relative to agent.yaml, or the instruction text itself.",
      "type": "string",
      "minLength": 1
    },
    "starter_prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": {
              "$ref": "#/$defs/string_map"
            },
            "secret_env": {
              "description": "Environment variable name to Secret Manager secret name. The latest version is used.",
              "$ref": "#/$defs/string_map"
            },
            "min_instances": {
              "type": "integer",
              "minimum": 0
            },
            "max_instances": {
              "type": "integer",
              "minimum": 1
            },
            "python_version": {
              "type": "string",
              "pattern": "^3\\.[0-9]+$"
            }
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gemini_enterprise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine"
          ],
          "properties": {
            "engine": {
              "description": "Id of the Gemini Enterprise engine. Spliced into the Discovery Engine URL path, so a slash would address another resource.",
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "string_map": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "effect": {
      "description": "Whether the tool only reads. Defaults to write, so anything not declared read-only is governed as a write.",
      "enum": [
        "read",
        "write"
      ]
    },
    "python_ref": {
      "description": "Fully qualified module and attribute below source, as pkg.module:ATTR.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "builtin"
          ],
          "properties": {
            "builtin": {
              "description": "Name of a tool in google.adk.tools, such as google_search.",
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mcp"
          ],
          "properties": {
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "$ref": "#/$defs/https_url"
                },
                "connection": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "headers": {
                  "description": "Fixed headers. Values may reference environment variables as ${VAR}; secrets do not belong here.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "allow": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "effect": {
                  "$ref": "#/$defs/effect"
                },
                "does_not": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python"
          ],
          "properties": {
            "python": {
              "oneOf": [
                {
                  "$ref": "#/$defs/python_ref"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref"
                  ],
                  "properties": {
                    "ref": {
                      "$ref": "#/$defs/python_ref"
                    },
                    "effect": {
                      "$ref": "#/$defs/effect"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^/?#\\s]+(?:[/?#]\\S*)?$"
    }
  }
}
