{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gete:schema:agent",
  "title": "agent.yaml",
  "description": "One agent: who it is, what it says, what it touches, where it runs, where it is listed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "display_name",
    "description",
    "model",
    "instruction"
  ],
  "properties": {
    "name": {
      "description": "RFC 1034 label. Becomes the Terraform module name, the service account name, and the prefix of authorization ids.",
      "type": "string",
      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
      "maxLength": 63
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "instruction": {
      "description": "Path relative to agent.yaml, or the instruction text itself.",
      "type": "string",
      "minLength": 1
    },
    "starter_prompts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connections": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          {
            "description": "A connection with scopes selected from its optional_scopes menu, on top of the defaults every agent gets. An entry that selects nothing is written as the plain string instead.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "scopes"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "scopes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "shared_credentials": {
      "description": "Tools acting with a credential the agent holds, not the caller's authorization. Whoever can call the agent acts through it, so the tools and their guardrails ship with gete; a declaration can only name them.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "slack_post"
        ]
      }
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_engine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": {
              "$ref": "#/$defs/string_map"
            },
            "secret_env": {
              "description": "Environment variable name to Secret Manager secret name. The latest version is used.",
              "$ref": "#/$defs/string_map"
            },
            "min_instances": {
              "type": "integer",
              "minimum": 0
            },
            "max_instances": {
              "type": "integer",
              "minimum": 1
            },
            "python_version": {
              "type": "string",
              "pattern": "^3\\.[0-9]+$"
            }
          }
        }
      }
    },
    "registration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gemini_enterprise": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine"
          ],
          "properties": {
            "engine": {
              "description": "Id of the Gemini Enterprise engine. Spliced into the Discovery Engine URL path, so a slash would address another resource.",
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "string_map": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "effect": {
      "description": "Whether the tool only reads. Defaults to write, so anything not declared read-only is governed as a write.",
      "enum": [
        "read",
        "write"
      ]
    },
    "python_ref": {
      "description": "Fully qualified module and attribute below source, as pkg.module:ATTR.",
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "tool": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "builtin"
          ],
          "properties": {
            "builtin": {
              "description": "Name of a tool in google.adk.tools, such as google_search.",
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mcp"
          ],
          "properties": {
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "$ref": "#/$defs/https_url"
                },
                "connection": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "headers": {
                  "description": "Fixed headers. Values may reference environment variables as ${VAR}; secrets do not belong here.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "allow": {
                  "description": "Tool names to offer, out of everything the server lists. An empty list would read as offering nothing, which no filter can express, so it is refused.",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "effect": {
                  "$ref": "#/$defs/effect"
                },
                "does_not": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openapi"
          ],
          "properties": {
            "openapi": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "spec",
                "connection",
                "operations"
              ],
              "properties": {
                "spec": {
                  "description": "Path to the OpenAPI description, relative to agent.yaml. It is read where the agent is packed and travels inside the archive; nothing is fetched at run time.",
                  "type": "string",
                  "minLength": 1
                },
                "connection": {
                  "description": "Request URLs are built from this connection's base_url, and the caller's token rides along.",
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "operations": {
                  "description": "operationIds to offer, out of everything the description holds. Required, never defaulted: a published description holds far more than an agent means to expose, and forgetting to choose must not mean offering everything.",
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "effect": {
                  "$ref": "#/$defs/effect"
                },
                "does_not": {
                  "type": "string",
                  "minLength": 1
                },
                "params": {
                  "description": "Constraints on the operations' parameters, by operationId, then by parameter or body property name. A dotted name reaches into the JSON body when no parameter carries the name literally. What was pinned in code must not be lost by moving to a declaration.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/openapi_param"
                    }
                  }
                },
                "only": {
                  "description": "The arguments the model may write, by operationId. Everything unlisted is taken out of the declaration and never sent; a params value still rides. A dotted name exposes just that path into the JSON body when no parameter carries the name literally. Naming what goes out fails safe when the description grows: a new field stays unexposed until someone declares it.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "describe": {
                  "description": "Replaces an operation's description. The vendor's text is written for developers next to the docs, not for a model; it may cite links and syntax the model cannot follow.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python"
          ],
          "properties": {
            "python": {
              "oneOf": [
                {
                  "$ref": "#/$defs/python_ref"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref"
                  ],
                  "properties": {
                    "ref": {
                      "$ref": "#/$defs/python_ref"
                    },
                    "effect": {
                      "$ref": "#/$defs/effect"
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^/?#\\s]+(?:[/?#]\\S*)?$"
    },
    "openapi_param": {
      "description": "One parameter's constraint: a fixed value the model never sees, or text put around what the model writes. A fixed parameter is taken out of the declaration shown to the model - its value is declared, so there is nothing left for the model to say, and prefix or suffix would have nothing to wrap. A null value is refused: the client drops absent values, so a fixed null would silently send nothing at all.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "not": {
                "type": "null"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "prefix": {
              "type": "string",
              "minLength": 1
            },
            "suffix": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  }
}
